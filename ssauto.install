<?php

/**
 * @file
 * Install, update, and uninstall functions for the ssauto module.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function ssauto_schema(): array {
  $schema['ssauto_index'] = [
    'description' => 'Stores a denormalised search index of node content for fast fulltext search.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Auto-increment primary key.',
      ],
      'nid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Node ID.',
      ],
      'title' => [
        'type' => 'varchar',
        'length' => 512,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Node title.',
      ],
      'summary' => [
        'type' => 'varchar',
        'length' => 500,
        'not null' => TRUE,
        'default' => '',
        'description' => 'First 500 plain-text characters of the body field.',
      ],
      'tags' => [
        'type' => 'varchar',
        'length' => 1024,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Taxonomy term names joined by space.',
      ],
      'url' => [
        'type' => 'varchar',
        'length' => 512,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Node URL alias or /node/{nid}.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Node created (published) timestamp.',
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Node changed timestamp.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'nid' => ['nid'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function ssauto_install(): void {
  // Add MySQL FULLTEXT indexes via raw SQL — the Schema API does not support
  // FULLTEXT index types, so we must issue ALTER TABLE statements directly.
  $db = \Drupal::database();

  // FULLTEXT on all searchable columns — used by autocomplete and search.
  try {
    $db->query('ALTER TABLE {ssauto_index} ADD FULLTEXT INDEX ft_full (title, summary, tags)');
  }
  catch (\Exception $e) {
    \Drupal::logger('ssauto')->warning('Could not add ft_full FULLTEXT index: @msg', ['@msg' => $e->getMessage()]);
  }

  \Drupal::messenger()->addStatus(t('Smart Search Autocomplete installed. Run <code>drush ssauto:rebuild</code> to build the initial index.'));
}

/**
 * Implements hook_uninstall().
 */
function ssauto_uninstall(): void {
  \Drupal::configFactory()->getEditable('ssauto.settings')->delete();
  \Drupal::service('cache_tags.invalidator')->invalidateTags(['ssauto_index']);
}

/**
 * Drops unused ft_title index, adds idx_created, expands summary to 500 chars.
 */
function ssauto_update_8003(): string {
  $db     = \Drupal::database();
  $schema = $db->schema();
  $log    = [];

  // Drop the ft_title FULLTEXT index — autocomplete now uses ft_full
  // (title, summary, tags). ft_title is no longer referenced anywhere.
  try {
    $db->query('ALTER TABLE {ssauto_index} DROP INDEX ft_title');
    $log[] = 'Dropped ft_title FULLTEXT index.';
  }
  catch (\Exception $e) {
    $log[] = 'ft_title index not found or already dropped — skipped.';
  }

  // Add a regular B-tree index on created for ORDER BY created DESC
  // used by the LIKE fallback search path.
  try {
    $db->query('ALTER TABLE {ssauto_index} ADD INDEX idx_created (created)');
    $log[] = 'Added idx_created index.';
  }
  catch (\Exception $e) {
    $log[] = 'idx_created index already exists — skipped.';
  }

  // Expand summary column from varchar(300) to varchar(500) to improve
  // search recall for long-form content.
  if ($schema->fieldExists('ssauto_index', 'summary')) {
    $schema->changeField('ssauto_index', 'summary', 'summary', [
      'type'        => 'varchar',
      'length'      => 500,
      'not null'    => TRUE,
      'default'     => '',
      'description' => 'First 500 plain-text characters of the body field.',
    ]);
    $log[] = 'Expanded summary column to varchar(500).';
  }

  return implode(' ', $log);
}

/**
 * Adds the created column to ssauto_index for existing installations.
 */
function ssauto_update_8002(): string {
  $db     = \Drupal::database();
  $schema = $db->schema();

  if (!$schema->fieldExists('ssauto_index', 'created')) {
    $schema->addField('ssauto_index', 'created', [
      'type'        => 'int',
      'not null'    => TRUE,
      'default'     => 0,
      'description' => 'Node created (published) timestamp.',
    ]);

    // Backfill from node_field_data using the default translation row.
    $db->query(
      "UPDATE {ssauto_index} si
       INNER JOIN {node_field_data} n ON si.nid = n.nid AND n.default_langcode = 1
       SET si.created = n.created"
    );

    return 'Added created column to ssauto_index and backfilled from node_field_data.';
  }

  return 'Column created already exists in ssauto_index — skipped.';
}

/**
 * Creates ssauto.settings config for existing installations.
 */
function ssauto_update_8001(): string {
  $config = \Drupal::configFactory()->getEditable('ssauto.settings');
  if ($config->isNew()) {
    $config
      ->set('autocomplete_limit', 8)
      ->set('results_per_page', 10)
      ->set('min_keyword_length', 2)
      ->set('cron_batch_size', 50)
      ->save();
    return 'Created ssauto.settings configuration with default values.';
  }
  return 'ssauto.settings already exists, skipped.';
}

{#
/**
 * @file
 * Template for the Smart Search Autocomplete overlay block.
 *
 * Available variables: none (populated via JS / drupalSettings).
 */
#}
<div class="ssauto-wrapper">

  {# Trigger button — toggles the overlay open/closed #}
  <button class="ssauto-trigger" type="button" aria-label="{{ 'Open search'|t }}" aria-expanded="false" aria-controls="ssauto-overlay">
    <span class="ssauto-trigger__icon ssauto-trigger__icon--search" aria-hidden="true">
      {# Magnifier SVG #}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </span>
    <span class="ssauto-trigger__icon ssauto-trigger__icon--close" aria-hidden="true">
      {# Close / X SVG #}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </span>
  </button>

  {# Backdrop — clicking it closes the overlay #}
  <div class="ssauto-backdrop" aria-hidden="true"></div>

  {# Overlay panel #}
  <div class="ssauto-overlay" id="ssauto-overlay" role="dialog" aria-modal="true" aria-label="{{ 'Site search'|t }}" hidden>

    {# Close button inside overlay #}
    <button class="ssauto-close" type="button" aria-label="{{ 'Close search'|t }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div class="ssauto-inner">

      {# Search label #}
      <p class="ssauto-label">{{ 'What are you looking for?'|t }}</p>

      {# Input row #}
      <div class="ssauto-row">
        <span class="ssauto-row__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </span>

        <input
          type="search"
          class="ssauto-input"
          placeholder="{{ 'Search…'|t }}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="{{ 'Search query'|t }}"
          aria-autocomplete="list"
          aria-controls="ssauto-suggestions"
          aria-activedescendant=""
        />

        <button class="ssauto-submit" type="button" aria-label="{{ 'Submit search'|t }}">
          {{ 'Search'|t }}
        </button>
      </div>

      {# Suggestions list — populated dynamically by ssauto.js #}
      <ul class="ssauto-suggestions" id="ssauto-suggestions" role="listbox" aria-label="{{ 'Search suggestions'|t }}"></ul>

      {# Keyboard hint bar #}
      <div class="ssauto-hint" aria-hidden="true">
        <span class="ssauto-hint__item">
          <kbd class="ssauto-key">↑</kbd><kbd class="ssauto-key">↓</kbd>
          {{ 'navigate'|t }}
        </span>
        <span class="ssauto-hint__item">
          <kbd class="ssauto-key">↵</kbd>
          {{ 'search'|t }}
        </span>
        <span class="ssauto-hint__item">
          <kbd class="ssauto-key">ESC</kbd>
          {{ 'close'|t }}
        </span>
      </div>

    </div>{# /.ssauto-inner #}
  </div>{# /.ssauto-overlay #}

</div>{# /.ssauto-wrapper #}
